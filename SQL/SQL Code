/*--------DATABASE & SOURCE DATA VALIDATION --------*/

CREATE TABLE STG_SUPPLY_CHAIN (
    payment_type       VARCHAR(100),
    days_real          INTEGER,
    days_scheduled     INTEGER,
    profit             NUMERIC(18,2),
    net_sales          NUMERIC(18,2),
    delivery_status    VARCHAR(100),
    delivery_risk      VARCHAR(100),
    category_id        INTEGER,
    category_name      VARCHAR(255),
    customer_city      VARCHAR(255),
    customer_country   VARCHAR(255),
    customer_id        INTEGER,
    customer_segment   VARCHAR(100),
    customer_state     VARCHAR(255),
    department_id      INTEGER,
    department_name    VARCHAR(255),
    market             VARCHAR(100),
    city               VARCHAR(255),
    country            VARCHAR(255),
    order_id           BIGINT,
    discount_amount    NUMERIC(18,2),
    discount_rate      NUMERIC(10,4),
    item_id            BIGINT,
    profit_ratio       NUMERIC(10,4),
    quantity           INTEGER,
    sales              NUMERIC(18,2),
    region             VARCHAR(100),
    state              VARCHAR(255),
    order_status       VARCHAR(100),
    product_name       VARCHAR(500),
    product_price      NUMERIC(18,2),
    product_status     INTEGER,
    shipping_mode      VARCHAR(100),
    order_date         DATE,
    delay_days         INTEGER,
    profit_status      VARCHAR(100)
);


SELECT current_database();

SELECT COUNT(*) AS total_rows
FROM public.stg_supply_chain;

SELECT *
FROM public.stg_supply_chain
LIMIT 10;

SELECT
    COUNT(*) AS total_rows,
    COUNT(DISTINCT item_id) AS total_items,
    COUNT(DISTINCT order_id) AS total_orders,
    COUNT(DISTINCT customer_id) AS total_customers,
    COUNT(DISTINCT product_name) AS total_products,
    MIN(order_date) AS first_order_date,
    MAX(order_date) AS last_order_date,
    COUNT(*) FILTER (WHERE order_date IS NULL) AS missing_dates
FROM public.stg_supply_chain;

--- Item ID Duplicate
SELECT
    item_id,
    COUNT(*) AS duplicate_count
FROM public.stg_supply_chain
GROUP BY item_id
HAVING COUNT(*) > 1
ORDER BY duplicate_count DESC;

--- Null Values

SELECT
    COUNT(*) FILTER (WHERE item_id IS NULL) AS missing_item_id,
    COUNT(*) FILTER (WHERE order_id IS NULL) AS missing_order_id,
    COUNT(*) FILTER (WHERE customer_id IS NULL) AS missing_customer_id,
    COUNT(*) FILTER (WHERE product_name IS NULL) AS missing_product_name,
    COUNT(*) FILTER (WHERE sales IS NULL) AS missing_sales,
    COUNT(*) FILTER (WHERE profit IS NULL) AS missing_profit
FROM public.stg_supply_chain;


/*------------ SECTION 2: DATA CONSISTENCY CHECKS ----------*/

--- Customer ID Distinct & Uniqe 
SELECT
    customer_id,
    COUNT(DISTINCT ROW(
        customer_segment,
        customer_city,
        customer_state,
        customer_country
    )) AS different_profiles
FROM public.stg_supply_chain
GROUP BY customer_id
HAVING COUNT(DISTINCT ROW(
    customer_segment,
    customer_city,
    customer_state,
    customer_country
)) > 1;

----- Product Name
SELECT
    product_name,
    COUNT(DISTINCT ROW(
        product_price,
        product_status,
        category_id,
        category_name,
        department_id,
        department_name
    )) AS different_product_profiles
FROM public.stg_supply_chain
GROUP BY product_name
HAVING COUNT(DISTINCT ROW(
    product_price,
    product_status,
    category_id,
    category_name,
    department_id,
    department_name
)) > 1;

--  Check Duplicated Order
SELECT
    order_id,
    COUNT(DISTINCT ROW(
        customer_id,
        order_date,
        order_status,
        shipping_mode,
        payment_type,
        delivery_status,
        delivery_risk,
        days_real,
        days_scheduled
    )) AS different_order_profiles
FROM public.stg_supply_chain
GROUP BY order_id
HAVING COUNT(DISTINCT ROW(
    customer_id,
    order_date,
    order_status,
    shipping_mode,
    payment_type,
    delivery_status,
    delivery_risk,
    days_real,
    days_scheduled
)) > 1;

-- Check Duplicated Geo 
SELECT
    COUNT(*) FILTER (WHERE country IS NULL) AS missing_country,
    COUNT(*) FILTER (WHERE market IS NULL) AS missing_market,
    COUNT(*) FILTER (WHERE region IS NULL) AS missing_region,
    COUNT(*) FILTER (WHERE city IS NULL) AS missing_city
FROM public.stg_supply_chain;

-- Discount Check 
SELECT
    MIN(discount_rate) AS min_discount_rate,
    MAX(discount_rate) AS max_discount_rate,
    MIN(discount_amount) AS min_discount_amount,
    MAX(discount_amount) AS max_discount_amount
FROM public.stg_supply_chain;

-- Check Order Status
SELECT
    order_status,
    COUNT(*) AS records_count
FROM public.stg_supply_chain
GROUP BY order_status
ORDER BY records_count DESC;

-- Delivery Check
SELECT
    delivery_status,
    COUNT(*) AS records_count
FROM public.stg_supply_chain
GROUP BY delivery_status
ORDER BY records_count DESC;


/*---------------  CREATE DIMENSIONAL MODEL TABLES  ------------------*/

-- Customer Dimension
CREATE TABLE IF NOT EXISTS public.dm_customer (
    customer_id BIGINT PRIMARY KEY,
    customer_segment VARCHAR(100),
    customer_city VARCHAR(150),
    customer_state VARCHAR(150),
    customer_country VARCHAR(150)
);

--  Product Dimension
CREATE TABLE IF NOT EXISTS public.dm_product (
    product_key BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    product_name TEXT NOT NULL UNIQUE,
    product_price NUMERIC(18,2),
    product_status VARCHAR(100),
    category_id BIGINT,
    category_name VARCHAR(200),
    department_id BIGINT,
    department_name VARCHAR(200)
);

--  Date Dimension
CREATE TABLE IF NOT EXISTS public.dm_date (
    date_key INTEGER PRIMARY KEY,
    full_date DATE UNIQUE NOT NULL,
    year_number INTEGER,
    quarter_number INTEGER,
    month_number INTEGER,
    month_name VARCHAR(20),
    year_month VARCHAR(7),
    day_number INTEGER,
    day_name VARCHAR(20)
);

-- Geography Dimension
CREATE TABLE IF NOT EXISTS public.dm_geography (
    geography_key BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    city VARCHAR(150),
    state VARCHAR(150),
    country VARCHAR(150),
    region VARCHAR(150),
    market VARCHAR(150),
    CONSTRAINT uq_dm_geography UNIQUE NULLS NOT DISTINCT
        (city, state, country, region, market)
);

-- Fact Table
CREATE TABLE IF NOT EXISTS public.fact_orderitems (
    item_id BIGINT PRIMARY KEY,
    order_id BIGINT NOT NULL,

    customer_id BIGINT,
    product_key BIGINT,
    date_key INTEGER,
    geography_key BIGINT,

    payment_type VARCHAR(100),
    shipping_mode VARCHAR(100),
    order_status VARCHAR(100),
    delivery_status VARCHAR(100),
    delivery_risk VARCHAR(100),

    days_real INTEGER,
    days_scheduled INTEGER,
    delay_days INTEGER,

    quantity INTEGER,
    sales NUMERIC(18,2),
    net_sales NUMERIC(18,2),
    discount_amount NUMERIC(18,2),
    discount_rate NUMERIC(12,6),
    profit NUMERIC(18,2),
    profit_ratio NUMERIC(18,6),
    profit_status VARCHAR(100),

    CONSTRAINT fk_fact_customer
        FOREIGN KEY (customer_id)
        REFERENCES public.dm_customer(customer_id),

    CONSTRAINT fk_fact_product
        FOREIGN KEY (product_key)
        REFERENCES public.dm_product(product_key),

    CONSTRAINT fk_fact_date
        FOREIGN KEY (date_key)
        REFERENCES public.dm_date(date_key),

    CONSTRAINT fk_fact_geography
        FOREIGN KEY (geography_key)
        REFERENCES public.dm_geography(geography_key)
);


/*--------------- LOAD DIMENSION TABLES --------------------*/

-- Load Customer Dimension
INSERT INTO public.dm_customer (
    customer_id,
    customer_segment,
    customer_city,
    customer_state,
    customer_country
)
