INSERT INTO public.dm_product (
    product_name,
    product_price,
    product_status,
    category_id,
    category_name,
    department_id,
    department_name
)
SELECT
    product_name,
    MIN(product_price),
    MIN(product_status),
    MIN(category_id),
    MIN(category_name),
    MIN(department_id),
    MIN(department_name)
FROM public.stg_supply_chain
WHERE product_name IS NOT NULL
GROUP BY product_name
ON CONFLICT (product_name) DO NOTHING;

-- Load Date Dimension
INSERT INTO public.dm_date (
    date_key,
    full_date,
    year_number,
    quarter_number,
    month_number,
    month_name,
    year_month,
    day_number,
    day_name
)
SELECT DISTINCT
    TO_CHAR(order_date, 'YYYYMMDD')::INTEGER,
    order_date,
    EXTRACT(YEAR FROM order_date)::INTEGER,
    EXTRACT(QUARTER FROM order_date)::INTEGER,
    EXTRACT(MONTH FROM order_date)::INTEGER,
    TO_CHAR(order_date, 'FMMonth'),
    TO_CHAR(order_date, 'YYYY-MM'),
    EXTRACT(DAY FROM order_date)::INTEGER,
    TO_CHAR(order_date, 'FMDay')
FROM public.stg_supply_chain
WHERE order_date IS NOT NULL
ON CONFLICT (date_key) DO NOTHING;

-- Load Geography Dimension
INSERT INTO public.dm_geography (
    city,
    state,
    country,
    region,
    market
)
SELECT DISTINCT
    city,
    state,
    country,
    region,
    market
FROM public.stg_supply_chain
ON CONFLICT DO NOTHING;


/*--------------------- LOAD FACT TABLE -------------------------*/

INSERT INTO public.fact_orderitems (
    item_id,
    order_id,
    customer_id,
    product_key,
    date_key,
    geography_key,
    payment_type,
    shipping_mode,
    order_status,
    delivery_status,
    delivery_risk,
    days_real,
    days_scheduled,
    delay_days,
    quantity,
    sales,
    net_sales,
    discount_amount,
    discount_rate,
    profit,
    profit_ratio,
    profit_status
)
SELECT
    s.item_id,
    s.order_id,
    s.customer_id,
    p.product_key,
    TO_CHAR(s.order_date, 'YYYYMMDD')::INTEGER,
    g.geography_key,
    s.payment_type,
    s.shipping_mode,
    s.order_status,
    s.delivery_status,
    s.delivery_risk,
    s.days_real,
    s.days_scheduled,
    s.delay_days,
    s.quantity,
    s.sales,
    s.net_sales,
    s.discount_amount,
    s.discount_rate,
    s.profit,
    s.profit_ratio,
    s.profit_status
FROM public.stg_supply_chain s
LEFT JOIN public.dm_product p
    ON s.product_name = p.product_name
LEFT JOIN public.dm_geography g
    ON s.city IS NOT DISTINCT FROM g.city
   AND s.state IS NOT DISTINCT FROM g.state
   AND s.country IS NOT DISTINCT FROM g.country
   AND s.region IS NOT DISTINCT FROM g.region
   AND s.market IS NOT DISTINCT FROM g.market
WHERE s.item_id IS NOT NULL
  AND s.order_id IS NOT NULL
ON CONFLICT (item_id) DO NOTHING;


