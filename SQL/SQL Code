/*-------------- CREATE ANALYTICAL VIEWS -----------------*/

-- Flat view: one row per order item
CREATE OR REPLACE VIEW public.vw_sales_flat AS
SELECT
    f.item_id,
    f.order_id,

    f.customer_id,
    c.customer_segment,
    c.customer_city,
    c.customer_state,
    c.customer_country,

    f.product_key,
    p.product_name,
    p.product_price,
    p.category_id,
    p.category_name,
    p.department_id,
    p.department_name,

    d.full_date AS order_date,
    d.year_number,
    d.quarter_number,
    d.month_number,
    d.month_name,
    d.year_month,

    g.city,
    g.state,
    g.country,
    g.region,
    g.market,

    f.payment_type,
    f.shipping_mode,
    f.order_status,
    f.delivery_status,
    f.delivery_risk,

    f.days_real,
    f.days_scheduled,
    f.delay_days,

    f.quantity,
    f.sales,
    f.net_sales,
    f.discount_amount,
    f.discount_rate,
    f.profit,
    f.profit_ratio,
    f.profit_status

FROM public.fact_orderitems f
LEFT JOIN public.dm_customer c
    ON f.customer_id = c.customer_id
LEFT JOIN public.dm_product p
    ON f.product_key = p.product_key
LEFT JOIN public.dm_date d
    ON f.date_key = d.date_key
LEFT JOIN public.dm_geography g
    ON f.geography_key = g.geography_key;


-- Order-level view: one row per order
CREATE OR REPLACE VIEW public.vw_orders_flat AS
SELECT
    order_id,
    MIN(customer_id) AS customer_id,
    MIN(order_date) AS order_date,
    MIN(year_number) AS year_number,
    MIN(month_number) AS month_number,
    MIN(year_month) AS year_month,
    MIN(market) AS market,
    MIN(country) AS country,
    MIN(region) AS region,
    MIN(shipping_mode) AS shipping_mode,
    MIN(payment_type) AS payment_type,
    MIN(order_status) AS order_status,
    MIN(delivery_status) AS delivery_status,
    MIN(delivery_risk) AS delivery_risk,
    MIN(days_real) AS days_real,
    MIN(days_scheduled) AS days_scheduled,
    MIN(delay_days) AS delay_days,
    COUNT(*) AS item_lines,
    SUM(quantity) AS total_quantity,
    SUM(sales) AS total_sales,
    SUM(net_sales) AS total_net_sales,
    SUM(discount_amount) AS total_discount,
    SUM(profit) AS total_profit
FROM public.vw_sales_flat
GROUP BY order_id;


-- KPI Summary View
CREATE OR REPLACE VIEW public.vw_kpi_summary AS
SELECT
    COUNT(DISTINCT order_id) AS total_orders,
    COUNT(DISTINCT customer_id) AS total_customers,
    COUNT(DISTINCT product_key) AS total_products,
    SUM(quantity) AS total_quantity,
    SUM(sales) AS total_sales,
    SUM(net_sales) AS total_net_sales,
    SUM(discount_amount) AS total_discount,
    SUM(profit) AS total_profit,
    AVG(profit_ratio) AS average_profit_ratio
FROM public.vw_sales_flat;


/*------------ BUSINESS CASE 1 - SHIPPING DELAYS -------------*/

-- shipping performance
SELECT
    delivery_status,
    COUNT(DISTINCT order_id) AS total_orders,
    ROUND(
        COUNT(DISTINCT order_id) * 100.0 /
        NULLIF((SELECT COUNT(DISTINCT order_id)
                FROM public.vw_orders_flat), 0), 2
    ) AS percentage
FROM public.vw_orders_flat
GROUP BY delivery_status
ORDER BY total_orders DESC;

-- Real days vs scheduled days by shipping mode
SELECT
    shipping_mode,
    COUNT(DISTINCT order_id) AS total_orders,
    ROUND(AVG(days_scheduled), 2) AS avg_scheduled_days,
    ROUND(AVG(days_real), 2) AS avg_actual_days,
    ROUND(AVG(delay_days), 2) AS avg_delay_days
FROM public.vw_orders_flat
GROUP BY shipping_mode
ORDER BY avg_delay_days DESC;

-- Late & on-time orders by market
SELECT
    market,
    COUNT(DISTINCT order_id) AS total_orders,
    COUNT(DISTINCT order_id) FILTER (
        WHERE delivery_status ILIKE '%late%'
    ) AS late_orders,
    COUNT(DISTINCT order_id) FILTER (
        WHERE delivery_status ILIKE '%on time%'
    ) AS on_time_orders,
    COUNT(DISTINCT order_id) FILTER (
        WHERE delivery_status ILIKE '%advance%'
    ) AS advance_orders
FROM public.vw_orders_flat
GROUP BY market
ORDER BY late_orders DESC;

-- Monthly shipping delay trend
SELECT
    year_month,
    COUNT(DISTINCT order_id) AS total_orders,
    COUNT(DISTINCT order_id) FILTER (
        WHERE delivery_status ILIKE '%late%'
    ) AS late_orders,
    ROUND(AVG(delay_days), 2) AS avg_delay_days
FROM public.vw_orders_flat
GROUP BY year_month
ORDER BY year_month;


/*------------ BUSINESS CASE 2 - LOSS-MAKING PRODUCTS --------------*/

-- Profitability by product
SELECT
    product_name,
    SUM(sales) AS total_sales,
    SUM(profit) AS total_profit,
    SUM(quantity) AS total_quantity,
    CASE
        WHEN SUM(profit) < 0 THEN 'Loss Making'
        WHEN SUM(profit) > 0 THEN 'Profitable'
        ELSE 'Break Even'
    END AS profitability_status
FROM public.vw_sales_flat
GROUP BY product_name
ORDER BY total_profit ASC;

-- Profitability by department
SELECT
    department_name,
    SUM(sales) AS total_sales,
    SUM(profit) AS total_profit,
    SUM(quantity) AS total_quantity
FROM public.vw_sales_flat
GROUP BY department_name
ORDER BY total_profit ASC;

-- Profitability by category
SELECT
    category_name,
    SUM(sales) AS total_sales,
    SUM(profit) AS total_profit,
    CASE
        WHEN SUM(profit) < 0 THEN 'Loss Making'
        ELSE 'Profitable'
    END AS profitability_status
FROM public.vw_sales_flat
GROUP BY category_name
ORDER BY total_profit ASC;

-- Losses by market
SELECT
    market,
    SUM(sales) AS total_sales,
    SUM(profit) AS total_profit,
    COUNT(DISTINCT order_id) AS total_orders
FROM public.vw_sales_flat
GROUP BY market
ORDER BY total_profit ASC;


/*---------- BUSINESS CASE 3 - DISCOUNT ANALYSIS --------------*/

-- Discount rate distribution
SELECT
    MIN(discount_rate) AS minimum_discount,
    MAX(discount_rate) AS maximum_discount,
    AVG(discount_rate) AS average_discount
FROM public.vw_sales_flat;

-- Classify orders by discount percentage
SELECT
    CASE
        WHEN discount_rate < 0.05 THEN '0% - 5%'
        WHEN discount_rate < 0.10 THEN '5% - 10%'
        WHEN discount_rate < 0.20 THEN '10% - 20%'
        WHEN discount_rate < 0.30 THEN '20% - 30%'
        ELSE '30% and Above'
    END AS discount_band,
    COUNT(DISTINCT order_id) AS total_orders,
    SUM(quantity) AS total_quantity,
    SUM(sales) AS total_sales,
    SUM(profit) AS total_profit,
    AVG(discount_rate) AS average_discount_rate
FROM public.vw_sales_flat
GROUP BY discount_band
ORDER BY MIN(discount_rate);

-- Profit impact by discount band
SELECT
    CASE
        WHEN discount_rate < 0.05 THEN '0% - 5%'
        WHEN discount_rate < 0.10 THEN '5% - 10%'
        WHEN discount_rate < 0.20 THEN '10% - 20%'
        WHEN discount_rate < 0.30 THEN '20% - 30%'
        ELSE '30% and Above'
    END AS discount_band,
    SUM(sales) AS total_sales,
    SUM(discount_amount) AS total_discount,
    SUM(profit) AS total_profit,
    ROUND(AVG(profit_ratio), 4) AS average_profit_ratio
FROM public.vw_sales_flat
GROUP BY discount_band
ORDER BY MIN(discount_rate);

-- Quantity sold by discount band
SELECT
    CASE
        WHEN discount_rate < 0.05 THEN '0% - 5%'
        WHEN discount_rate < 0.10 THEN '5% - 10%'
        WHEN discount_rate < 0.20 THEN '10% - 20%'
        WHEN discount_rate < 0.30 THEN '20% - 30%'
        ELSE '30% and Above'
    END AS discount_band,
    SUM(quantity) AS units_sold
FROM public.vw_sales_flat
GROUP BY discount_band
ORDER BY MIN(discount_rate);


/*-------------- BUSINESS CASE 4 - FRAUD & CANCELLATIONS --------------*/

-- Inspect order status values
SELECT
    order_status,
    COUNT(DISTINCT order_id) AS total_orders
FROM public.vw_orders_flat
GROUP BY order_status
ORDER BY total_orders DESC;

-- Search for cancellation-related statuses
SELECT
    order_status,
    COUNT(DISTINCT order_id) AS total_orders
FROM public.vw_orders_flat
WHERE order_status ILIKE '%cancel%'
GROUP BY order_status;

-- Search for fraud-related statuses
SELECT
    order_status,
    COUNT(DISTINCT order_id) AS total_orders
FROM public.vw_orders_flat
WHERE order_status ILIKE '%fraud%'
GROUP BY order_status;

-- Cancellations and suspected fraud by market
SELECT
    market,
    COUNT(DISTINCT order_id) AS total_orders,
    COUNT(DISTINCT order_id) FILTER (
        WHERE order_status ILIKE '%cancel%'
    ) AS cancelled_orders,
    COUNT(DISTINCT order_id) FILTER (
        WHERE order_status ILIKE '%fraud%'
    ) AS fraud_flagged_orders
FROM public.vw_orders_flat
GROUP BY market
ORDER BY fraud_flagged_orders DESC;

-- Cancelled and fraud-flagged orders details
SELECT
    order_id,
    customer_id,
    order_date,
    market,
    country,
    order_status,
    total_sales,
    total_profit
FROM public.vw_orders_flat
WHERE order_status ILIKE '%cancel%'
   OR order_status ILIKE '%fraud%'
ORDER BY order_date;


/*---------BUSINESS CASE 5 - PRODUCT & CATEGORY CONCENTRATION -------*/

-- Sales contribution by product
SELECT
    product_name,
    SUM(sales) AS product_sales,
    ROUND(
        SUM(sales) * 100.0 /
        NULLIF((SELECT SUM(sales)
                FROM public.vw_sales_flat), 0), 2
    ) AS sales_percentage
FROM public.vw_sales_flat
GROUP BY product_name
ORDER BY product_sales DESC;

-- Sales contribution by category
SELECT
    category_name,
    SUM(sales) AS category_sales,
    SUM(quantity) AS total_quantity,
    ROUND(
        SUM(sales) * 100.0 /
        NULLIF((SELECT SUM(sales)
                FROM public.vw_sales_flat), 0), 2
    ) AS sales_percentage
FROM public.vw_sales_flat
GROUP BY category_name
ORDER BY category_sales DESC;

-- Product ranking by sales
SELECT
    product_name,
    SUM(sales) AS total_sales,
    SUM(profit) AS total_profit,
    DENSE_RANK() OVER (ORDER BY SUM(sales) DESC) AS sales_rank
FROM public.vw_sales_flat
GROUP BY product_name
ORDER BY sales_rank;

-- Pareto analysis: cumulative product sales contribution
WITH product_sales AS (
    SELECT
        product_name,
        SUM(sales) AS total_sales
    FROM public.vw_sales_flat
    GROUP BY product_name
),
ranked_products AS (
    SELECT
        product_name,
        total_sales,
        SUM(total_sales) OVER (
            ORDER BY total_sales DESC
        ) AS cumulative_sales,
        SUM(total_sales) OVER () AS overall_sales
    FROM product_sales
)
SELECT
    product_name,
    total_sales,
    ROUND(
        cumulative_sales * 100.0 /
        NULLIF(overall_sales, 0), 2
    ) AS cumulative_sales_percentage
FROM ranked_products
ORDER BY total_sales DESC;


/*-------------  BUSINESS CASE 6 - CUSTOMER LOYALTY ----------*/

--Customer purchase frequency
SELECT
    customer_id,
    COUNT(DISTINCT order_id) AS total_orders,
    SUM(total_sales) AS total_sales,
    SUM(total_profit) AS total_profit
FROM public.vw_orders_flat
GROUP BY customer_id
ORDER BY total_orders DESC;

-- Customer loyalty classification
WITH customer_orders AS (
    SELECT
        customer_id,
        COUNT(DISTINCT order_id) AS total_orders,
        SUM(total_sales) AS total_sales,
        SUM(total_profit) AS total_profit
    FROM public.vw_orders_flat
    GROUP BY customer_id
)
SELECT
    customer_id,
    total_orders,
    total_sales,
    total_profit,
    CASE
        WHEN total_orders >= 10 THEN 'High Loyalty'
        WHEN total_orders >= 5 THEN 'Medium Loyalty'
        ELSE 'Low Loyalty'
    END AS loyalty_segment
FROM customer_orders
ORDER BY total_orders DESC;

-- Customer segment performance
SELECT
    customer_segment,
    COUNT(DISTINCT customer_id) AS total_customers,
    COUNT(DISTINCT order_id) AS total_orders,
    SUM(sales) AS total_sales,
    SUM(profit) AS total_profit
FROM public.vw_sales_flat
GROUP BY customer_segment
ORDER BY total_sales DESC;

-- Top 20 customers by sales
SELECT
    customer_id,
    COUNT(DISTINCT order_id) AS total_orders,
    SUM(total_sales) AS total_sales,
    SUM(total_profit) AS total_profit
FROM public.vw_orders_flat
GROUP BY customer_id
ORDER BY total_sales DESC
LIMIT 20;


/*---------------- BUSINESS CASE 7 - MARKET ANALYSIS -------------*/

-- Sales and profit by market
SELECT
    market,
    COUNT(DISTINCT order_id) AS total_orders,
    SUM(sales) AS total_sales,
    SUM(net_sales) AS total_net_sales,
    SUM(profit) AS total_profit,
    SUM(quantity) AS total_quantity
FROM public.vw_sales_flat
GROUP BY market
ORDER BY total_sales DESC;

-- Country performance
SELECT
    market,
    country,
    COUNT(DISTINCT order_id) AS total_orders,
    SUM(sales) AS total_sales,
    SUM(profit) AS total_profit
FROM public.vw_sales_flat
GROUP BY market, country
ORDER BY total_sales DESC;

-- Regional performance
SELECT
    region,
    COUNT(DISTINCT order_id) AS total_orders,
    SUM(sales) AS total_sales,
    SUM(profit) AS total_profit
FROM public.vw_sales_flat
GROUP BY region
ORDER BY total_sales DESC;

-- Market profitability
SELECT
    market,
    SUM(sales) AS total_sales,
    SUM(profit) AS total_profit,
    ROUND(
        SUM(profit) * 100.0 /
        NULLIF(SUM(sales), 0), 2
    ) AS profit_margin_percentage
FROM public.vw_sales_flat
GROUP BY market
ORDER BY profit_margin_percentage DESC;





